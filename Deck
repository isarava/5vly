    function getPhase(idx) {
      for (var i = 0; i < phases.length; i++) {
        if (idx >= phases[i].start && idx <= phases[i].end) return phases[i];
      }
      return phases[phases.length-1];
    }

    function buildFlowSteps() {
      var el = document.getElementById("flowSteps");
      if (!el) return;
      var h = "";
      for (var i = 0; i < phases.length; i++) {
        h += "<div id='ph_" + i + "' style='display:flex;align-items:center;gap:0.3rem;padding:0.15rem 0.3rem;border-radius:3px;transition:all 0.3s;'>" +
          "<span style='font-size:0.75rem;'>" + phases[i].icon + "</span><span>" + phases[i].label + "</span></div>";
      }
      el.innerHTML = h;
    }

    function showFrame(idx) {
      if (idx < 0 || idx >= demoFrames.length) return;
      demoIdx = idx;
      var img = document.getElementById("demoImg");
      if (img) img.src = demoFrames[idx];
      var counter = document.getElementById("demoCounter");
      if (counter) counter.textContent = (idx+1) + " / " + demoFrames.length;
      var prog = document.getElementById("demoProgress");
      if (prog) prog.style.width = ((idx+1)/demoFrames.length*100) + "%";
      var phase = getPhase(idx);
      var label = document.getElementById("demoLabel");
      if (label) label.textContent = phase.label;
      var urlEl = document.getElementById("demoUrl");
      if (urlEl) urlEl.textContent = phase.url;
      for (var i = 0; i < phases.length; i++) {
        var phEl = document.getElementById("ph_" + i);
        if (!phEl) continue;
        var isActive = (idx >= phases[i].start && idx <= phases[i].end);
        var isPast = (idx > phases[i].end);
        phEl.style.background = isActive ? "rgba(13,148,136,0.2)" : "transparent";
        phEl.style.color = isActive ? "#2DD4BF" : (isPast ? "#94A3B8" : "#475569");
        phEl.style.fontWeight = isActive ? "600" : "400";
      }
    }

    function play() {
      stop();
      demoTimer = setInterval(function() {
        demoIdx++;
        if (demoIdx >= demoFrames.length) demoIdx = 0;
        showFrame(demoIdx);
      }, demoSpeed);
    }

    function stop() { if (demoTimer) { clearInterval(demoTimer); demoTimer = null; } }

    window.demoStop = stop;
    window.demoReset = function() {
      stop();
      showFrame(0);
      play();
    };

    setTimeout(function() {
      buildFlowSteps();
      showFrame(0);
      var playBtn = document.getElementById("demoPlayBtn");
      var pauseBtn = document.getElementById("demoPauseBtn");
      var slowBtn = document.getElementById("demoSlowBtn");
      var fastBtn = document.getElementById("demoFastBtn");
      if (playBtn) playBtn.addEventListener("click", function() { play(); });
      if (pauseBtn) pauseBtn.addEventListener("click", function() { stop(); });
      if (slowBtn) slowBtn.addEventListener("click", function() { demoSpeed = 1800; if (demoTimer) play(); });
      if (fastBtn) fastBtn.addEventListener("click", function() { demoSpeed = 400; if (demoTimer) play(); });
    }, 200);
  })();
  </script>
</div>

