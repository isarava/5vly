<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>5vly — Cross-Border Financial Identity Infrastructure</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --navy: #0B1A2E;
  --navy-mid: #122B47;
  --navy-light: #1E3A5F;
  --teal: #0D9488;
  --teal-light: #14B8A6;
  --mint: #2DD4BF;
  --white: #FFFFFF;
  --off-white: #F8FAFB;
  --light-gray: #E2E8F0;
  --med-gray: #94A3B8;
  --dark-text: #1E293B;
  --body-text: #475569;
  --gold: #F59E0B;
  --coral: #F87171;
  --emerald: #10B981;
  --purple: #8B5CF6;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
  background: #0a0a0f;
  font-family: 'DM Sans', sans-serif;
  color: var(--white);
  overflow-x: hidden;
  overflow-y: auto;
  margin: 0;
  scroll-behavior: smooth;
}

/* ===== SCALE WRAPPER ===== */
.scale-wrapper {
  width: 100%;
  overflow-y: auto;
  overflow-x: hidden;
}

/* ===== SLIDE CONTAINER ===== */
.deck {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  position: relative;
}

.slide {
  position: relative;
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 60px 80px;
  opacity: 1;
  transform: none;
  pointer-events: auto;
  overflow: hidden;
  box-sizing: border-box;
}

.slide.active {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}

/* ===== BACKGROUNDS ===== */
.bg-dark {
  background: linear-gradient(135deg, var(--navy) 0%, #0d1f35 50%, var(--navy) 100%);
}

.bg-light {
  background: var(--off-white);
  color: var(--dark-text);
}

.bg-dark::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at 20% 50%, rgba(13,148,136,0.06) 0%, transparent 60%),
              radial-gradient(ellipse at 80% 20%, rgba(13,148,136,0.04) 0%, transparent 50%);
  pointer-events: none;
}

/* Geometric accents for dark slides */
.bg-dark .geo-accent-tr {
  position: absolute; top: 0; right: 0;
  width: 180px; height: 4px; background: var(--teal);
}
.bg-dark .geo-accent-tr::after {
  content: ''; position: absolute; top: 0; right: 0;
  width: 4px; height: 120px; background: var(--teal);
}
.bg-dark .geo-accent-bl {
  position: absolute; bottom: 0; left: 0;
  width: 180px; height: 4px; background: var(--teal);
}
.bg-dark .geo-accent-bl::after {
  content: ''; position: absolute; bottom: 0; left: 0;
  width: 4px; height: 120px; background: var(--teal);
}

/* Top teal bar for light slides */
.bg-light::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0;
  height: 4px; background: var(--teal);
}

/* ===== TYPOGRAPHY ===== */
.label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  color: var(--teal);
  text-transform: uppercase;
  margin-bottom: 0.75rem;
}

h1 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 700;
  line-height: 1.15;
  margin-bottom: 1rem;
}

h2 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(1.3rem, 2.5vw, 2rem);
  font-weight: 600;
  line-height: 1.25;
  margin-bottom: 0.75rem;
}

.subtitle {
  font-size: 1rem;
  color: var(--med-gray);
  line-height: 1.6;
  max-width: 700px;
}

.bg-light .subtitle { color: var(--body-text); }

.teal { color: var(--teal); }
.gold { color: var(--gold); }
.coral { color: var(--coral); }
.emerald { color: var(--emerald); }
.purple { color: var(--purple); }
.mint { color: var(--mint); }

/* ===== CARDS ===== */
.card-grid {
  display: grid;
  gap: 1rem;
  margin-top: 1.5rem;
}

.card {
  background: rgba(18, 43, 71, 0.6);
  border: 1px solid rgba(13,148,136,0.15);
  border-radius: 8px;
  padding: 1.25rem;
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(8px);
}

.bg-light .card {
  background: var(--white);
  border: 1px solid var(--light-gray);
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.card-accent {
  position: absolute; top: 0; left: 0; right: 0;
  height: 3px;
}

.card h3 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  margin-bottom: 0.5rem;
}

.card p {
  font-size: 0.85rem;
  line-height: 1.5;
  color: var(--med-gray);
}

.bg-light .card p { color: var(--body-text); }

/* ===== ICON CIRCLES ===== */
.icon-circle {
  width: 44px; height: 44px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem;
  margin-bottom: 0.75rem;
  color: white;
}

/* ===== STAT BOXES ===== */
.stat-box {
  text-align: center;
  padding: 1.5rem 1rem;
  background: var(--white);
  border-radius: 8px;
  box-shadow: 0 2px 16px rgba(0,0,0,0.06);
}

.stat-box .value {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  font-weight: 700;
  color: var(--teal);
}

.stat-box .value.gold { color: var(--gold); }

.stat-box .stat-label {
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  color: var(--body-text);
  text-transform: uppercase;
  margin-top: 0.3rem;
  font-weight: 600;
}

/* ===== BADGES ===== */
.badge {
  display: inline-block;
  padding: 0.2rem 0.6rem;
  border-radius: 3px;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: white;
  text-transform: uppercase;
}

/* ===== TABLES ===== */
.matrix-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.8rem;
  margin-top: 1rem;
}

.matrix-table th, .matrix-table td {
  padding: 0.75rem 0.5rem;
  border: 1px solid var(--light-gray);
  text-align: center;
  vertical-align: middle;
}

.matrix-table th {
  background: var(--light-gray);
  font-weight: 600;
  color: var(--dark-text);
  font-size: 0.75rem;
}

.matrix-table th.teal-header {
  background: var(--teal);
  color: white;
}

.matrix-table .blue-ocean {
  background: #E6FAF8;
  color: var(--teal);
  font-weight: 700;
  font-size: 0.95rem;
}

.matrix-table .red-ocean {
  background: #FFF5F5;
  color: var(--coral);
  font-size: 0.72rem;
}

/* ===== FUNNEL ===== */
.funnel-bar {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0.35rem 0.75rem;
  border-radius: 6px;
  margin-bottom: 0.3rem;
  color: white;
  font-size: 0.85rem;
  transition: all 0.3s;
}

.funnel-bar .funnel-label {
  font-weight: 700;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.82rem;
}

.funnel-bar .funnel-desc {
  font-size: 0.7rem;
  opacity: 0.85;
  line-height: 1.4;
  margin-top: 0.1rem;
}

/* ===== TIMELINE ===== */
.timeline-row {
  display: flex;
  align-items: flex-end;
  gap: 0.25rem;
  text-align: center;
  margin: 0.5rem 0;
}

.yr {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.yr-val {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(1.3rem, 2.5vw, 1.8rem);
  font-weight: 800;
  color: var(--dark-text);
  line-height: 1.2;
}

.yr-label {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--med-gray);
  margin-top: 0.15rem;
}

.yr-pct {
  font-size: 0.65rem;
  color: var(--med-gray);
  opacity: 0.7;
}

/* Growth bar under each year */
.yr::after {
  content: '';
  display: block;
  width: 100%;
  border-radius: 4px 4px 0 0;
  margin-bottom: 0.3rem;
  order: -1;
}

.yr:nth-child(1)::after { height: 30px; background: #E2E8F0; }
.yr:nth-child(2)::after { height: 45px; background: #CBD5E1; }
.yr:nth-child(3)::after { height: 65px; background: #94A3B8; }
.yr:nth-child(4)::after { height: 80px; background: var(--teal); }
.yr:nth-child(5)::after { height: 95px; background: var(--teal); opacity: 0.7; }

.timeline-item {
  flex: 1;
  position: relative;
}

.timeline-item .t-value {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--dark-text);
}

.timeline-item .t-value.highlight {
  color: var(--teal);
  font-size: 1.5rem;
}

.timeline-item .t-year {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--body-text);
  margin-top: 0.5rem;
}

.timeline-item .t-pct {
  font-size: 0.7rem;
  color: var(--med-gray);
}

.timeline-line {
  height: 3px;
  background: var(--light-gray);
  position: relative;
  margin: 0.5rem 0;
}

.timeline-dot {
  width: 14px; height: 14px;
  border-radius: 50%;
  background: var(--med-gray);
  margin: -5.5px auto 0;
  position: relative;
}

.timeline-dot.active {
  background: var(--teal);
  width: 18px; height: 18px;
  margin: -7.5px auto 0;
}

/* ===== STEPS FLOW ===== */
.steps-flow {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.5rem;
  align-items: stretch;
}

.step-card {
  background: var(--navy-mid);
  border-radius: 8px;
  padding: 1.25rem;
  text-align: center;
  border-top: 3px solid var(--teal);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 140px;
}

.step-num {
  width: 40px; height: 40px;
  background: var(--teal);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: 1.1rem;
  margin: 0 auto 0.75rem;
}

.step-card h4 {
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  margin-bottom: 0.5rem;
  font-weight: 600;
}

.step-card p {
  font-size: 0.8rem;
  color: var(--med-gray);
}

.step-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--teal);
  font-size: 1.2rem;
  padding-top: 2rem;
}

/* ===== SCREENSHOTS ===== */
.screenshot-frame {
  background: white;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 8px 32px rgba(0,0,0,0.15);
  border: 1px solid rgba(0,0,0,0.08);
}

.screenshot-frame img {
  width: 100%;
  display: block;
}

/* ===== COMPETITOR COLUMNS ===== */
.comp-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-top: 1rem;
}

.comp-column {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.comp-header {
  padding: 0.5rem 0.75rem;
  border-radius: 6px 6px 0 0;
  font-weight: 700;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  color: white;
}

.comp-item {
  background: var(--navy-mid);
  padding: 0.6rem 0.75rem;
  border-left: 3px solid;
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.comp-item .comp-name {
  font-weight: 700;
  font-size: 0.85rem;
}

.comp-item .comp-stage {
  font-size: 0.72rem;
  font-family: 'JetBrains Mono', monospace;
}

.comp-item .comp-desc {
  font-size: 0.75rem;
  color: var(--med-gray);
  line-height: 1.4;
}

/* ===== CORRIDOR ROWS ===== */
.corridor-row {
  display: grid;
  grid-template-columns: 80px 1.2fr 0.6fr 1.5fr 1.5fr;
  align-items: center;
  gap: 0.75rem;
  padding: 0.6rem 0.75rem;
  background: var(--white);
  border-radius: 6px;
  margin-bottom: 0.4rem;
  box-shadow: 0 1px 4px rgba(0,0,0,0.04);
  border-left: 3px solid;
  font-size: 0.85rem;
}

.corridor-row .region {
  font-weight: 700;
  color: var(--dark-text);
}

.corridor-row .migrants {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--teal);
  text-align: center;
}

.corridor-row .routes {
  color: var(--body-text);
  font-size: 0.8rem;
}

.corridor-row .status {
  font-weight: 600;
  font-size: 0.8rem;
}

/* ===== MILESTONE LIST ===== */
.milestone-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.4rem;
}

.milestone-item span {
  font-size: 0.85rem;
  color: var(--dark-text);
}

/* ===== ADVANTAGES GRID ===== */
.adv-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-top: 1.25rem;
}

.adv-card {
  background: var(--navy-mid);
  border-radius: 8px;
  padding: 1.25rem;
  border-left: 4px solid;
}

.adv-card .adv-num {
  width: 32px; height: 32px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center; justify-content: center;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: 0.9rem;
  color: white;
  margin-right: 0.5rem;
  vertical-align: middle;
}

.adv-card h3 {
  display: inline;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  vertical-align: middle;
}

.adv-card p {
  font-size: 0.8rem;
  color: var(--med-gray);
  line-height: 1.5;
  margin-top: 0.6rem;
}

/* ===== REVENUE TABLE ===== */
.rev-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 1rem;
}

.rev-table th {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  color: var(--teal);
  text-align: left;
  padding: 0.5rem 0.75rem;
  border-bottom: 1px solid rgba(13,148,136,0.2);
}

.rev-table td {
  padding: 0.6rem 0.75rem;
  font-size: 0.85rem;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.rev-table .yr5 {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: 1rem;
}

.rev-table .total-row td {
  background: var(--teal);
  font-weight: 700;
  border-radius: 4px;
}

/* ===== USE OF FUNDS BAR ===== */
.funds-bar {
  display: flex;
  height: 32px;
  border-radius: 4px;
  overflow: hidden;
  margin: 1rem 0 0.5rem;
}

.funds-bar > div {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  font-weight: 700;
  color: white;
}

.funds-labels {
  display: flex;
  gap: 0;
  font-size: 0.75rem;
  margin-bottom: 1rem;
}

.funds-labels > div {
  text-align: center;
  color: var(--med-gray);
}

.funds-labels .fl-title {
  font-weight: 600;
  color: var(--white);
  margin-bottom: 0.15rem;
}

/* ===== MILESTONES GRID ===== */
.ms-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 1rem;
}

.ms-card {
  background: var(--navy-mid);
  border-radius: 8px;
  padding: 1rem;
  border-top: 3px solid;
}

.ms-card .ms-month {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  margin-bottom: 0.3rem;
}

.ms-card h4 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.ms-card p {
  font-size: 0.8rem;
  color: var(--med-gray);
  line-height: 1.6;
}

/* ===== TEAM ===== */
.founder-card {
  display: flex;
  gap: 1.5rem;
  background: var(--white);
  border-radius: 8px;
  padding: 1.5rem;
  border-top: 3px solid var(--teal);
  box-shadow: 0 2px 16px rgba(0,0,0,0.06);
  margin-bottom: 1rem;
}

.founder-photo {
  width: 200px;
  border-radius: 6px;
  object-fit: contain;
  flex-shrink: 0;
}

.founder-info h3 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--dark-text);
}

.founder-info .role {
  color: var(--teal);
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
}

.founder-info p {
  font-size: 0.8rem;
  color: var(--body-text);
  line-height: 1.6;
}

.partner-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}

.partner-card {
  background: var(--white);
  border-radius: 8px;
  padding: 1rem;
  border-top: 3px solid var(--teal);
  box-shadow: 0 1px 8px rgba(0,0,0,0.04);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.partner-card .partner-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  color: var(--teal);
  margin-bottom: 0.4rem;
}

.partner-card .partner-name {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  color: var(--dark-text);
  margin-bottom: 0.4rem;
}

.partner-card p {
  font-size: 0.78rem;
  color: var(--body-text);
  line-height: 1.5;
}

.partner-logo {
  max-height: 60px;
  margin: 0.5rem 0;
  object-fit: contain;
}

/* ===== NAVIGATION ===== */
.nav-bar {
  display: none;
}

.progress-bar {
  position: fixed;
  top: 0; left: 0;
  height: 3px;
  background: var(--teal);
  z-index: 101;
  transition: width 0.15s ease;
}

/* ===== CALLOUT BAR ===== */
.callout {
  background: var(--navy);
  padding: 1rem 1.25rem;
  border-radius: 6px;
  margin-top: 1rem;
  font-size: 0.85rem;
  border-left: 3px solid var(--teal);
}

.bg-light .callout {
  background: var(--navy);
  color: var(--white);
}

.callout strong { color: var(--teal); }

/* ===== BRIDGE BOXES ===== */
.bridges {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-top: 1rem;
}

.bridge-box {
  background: var(--navy-mid);
  border-radius: 8px;
  padding: 1rem;
  border-left: 3px solid;
}

.bridge-box h4 {
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  margin-bottom: 0.3rem;
}

.bridge-box p {
  font-size: 0.8rem;
  color: var(--med-gray);
}

/* ===== BOTTOM BOXES (failed/acquired) ===== */
.bottom-boxes {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-top: 0.75rem;
}

.bottom-box {
  padding: 0.75rem;
  border-radius: 6px;
  border-top: 3px solid;
  font-size: 0.78rem;
  line-height: 1.5;
}

.bottom-box h4 {
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  margin-bottom: 0.3rem;
}

/* ===== ANIMATIONS ===== */
.fade-up {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.fade-up.visible {
  opacity: 1;
  transform: translateY(0);
}

.fade-up-1 { transition-delay: 0.1s; }
.fade-up-2 { transition-delay: 0.2s; }
.fade-up-3 { transition-delay: 0.3s; }
.fade-up-4 { transition-delay: 0.4s; }
.fade-up-5 { transition-delay: 0.5s; }

/* ===== RESPONSIVE ===== */
@media (max-width: 900px) {
  .slide { padding: 40px 24px; min-height: auto; }
  .steps-flow { grid-template-columns: repeat(2, 1fr); }
  .adv-grid { grid-template-columns: 1fr; }
